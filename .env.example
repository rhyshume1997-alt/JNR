# Set these in Vercel: Project Settings, Environment Variables (Production and Preview).
# For local testing copy this file to .env.local and run: npx vercel dev

# Required. API key from resend.com
RESEND_API_KEY=

# Required. Where quote requests are sent (the owner's Outlook address). Comma separate for more than one.
QUOTE_TO=

# Optional. Sender address, on a domain you have verified in Resend. Defaults to info@jnrengineering.co.uk
QUOTE_FROM=
