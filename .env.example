# Set these in Vercel: Project Settings, Environment Variables (Production and Preview).
# For local testing copy this file to .env.local and run: npx vercel dev

# Required. API key from resend.com
RESEND_API_KEY=

# Required. Where quote requests are sent (the owner's Outlook address). Comma separate for more than one.
QUOTE_TO=

# Optional. Sender address, on a domain you have verified in Resend. Defaults to info@jnrengineering.co.uk
QUOTE_FROM=
TURNSTILE_SECRET_KEY=
QUOTE_QUARANTINE_TO=
# optional, defaults to jnrengineering.co.uk and www.jnrengineering.co.uk
TURNSTILE_HOSTNAMES=

# ---- Workshop content system (see docs/WORKSHOP-SETUP.md). Names only; set real values in Vercel.
# Postgres connection string (use the provider's pooled string on Vercel)
DATABASE_URL=
SITE_URL=https://jnrengineering.co.uk
# Optional: extra origins allowed to call /api/admin (comma separated). Normally empty.
ALLOWED_ORIGINS=
SESSION_HOURS=12
# S3-compatible storage (Cloudflare R2 recommended: 10GB free). Two buckets: one private, one public.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PRIVATE=
S3_BUCKET_PUBLIC=
# Public base URL of the public bucket, no trailing slash, for example https://media.jnrengineering.co.uk
PUBLIC_MEDIA_BASE_URL=
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_PER_ENTRY=12
# Buffer (server side only). BUFFER_ENV=staging can only ever use BUFFER_STAGING_CHANNEL_ID.
BUFFER_API_TOKEN=
BUFFER_ENV=staging
BUFFER_STAGING_CHANNEL_ID=
# Set when JNR's own LinkedIn page is connected to Buffer, then switch BUFFER_ENV to production
BUFFER_CHANNEL_ID_LINKEDIN=
# Optional AI captions. OFF unless AI_CAPTIONS_ENABLED=true. This is a paid API: confirm the cost first.
AI_CAPTIONS_ENABLED=
ANTHROPIC_API_KEY=
AI_CAPTION_MODEL=
# Optional, off by default. Future read-only Tolra stage lookup (docs/TOLRA-INTEGRATION.md)
TOLRA_ENABLED=
TOLRA_READ_URL=
TOLRA_READ_TOKEN=
