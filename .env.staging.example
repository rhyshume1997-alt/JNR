# STAGING SETTINGS. Copy this file to .env.staging (git-ignored) and fill it in. Never commit .env.staging.
# The same values (except DATABASE_URL, which Neon adds for you) go into Vercel > Project > Settings > Environment Variables,
# ticking ONLY "Preview". Mark every secret "Sensitive".

# Neon (pooled string). In Vercel the Neon integration creates this variable for you; copy the same value here
# from Neon's dashboard (Connect > pooled). It ends in ?sslmode=require
DATABASE_URL=

# Cloudflare R2. S3_ENDPOINT is https://<account id>.r2.cloudflarestorage.com with NO bucket name on the end.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PRIVATE=
S3_BUCKET_PUBLIC=
# The public address of the public bucket (R2 > bucket > Settings > Public Development URL), https, NO trailing slash.
PUBLIC_MEDIA_BASE_URL=

# Buffer. Staging can only ever use the one staging channel below (your personal LinkedIn profile).
BUFFER_API_TOKEN=
BUFFER_ENV=staging
BUFFER_STAGING_CHANNEL_ID=6afa05fbece6dfde5fd74165

# Vercel preview address (used by the CORS check)
SITE_URL=https://jnr-git-feature-workshop-content-rhsys-projects.vercel.app
STAGING_ORIGIN=https://jnr-git-feature-workshop-content-rhsys-projects.vercel.app

# Leave these OFF.
AI_CAPTIONS_ENABLED=
TOLRA_ENABLED=
