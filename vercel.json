{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/work",
      "destination": "/projects/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/our-work", "destination": "/api/public?view=index" },
    { "source": "/our-work/:slug", "destination": "/api/public?view=entry&slug=:slug" },
    { "source": "/api/feed", "destination": "/api/public?view=feed" },
    { "source": "/sitemap-work.xml", "destination": "/api/public?view=sitemap" },
    { "source": "/api/admin/:path*", "destination": "/api/admin?path=:path*" }
  ],
  "headers": [
    {
      "source": "/(admin|workshop)(/.*)?",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' blob: data:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
      ]
    }
  ],
  "functions": {
    "api/admin.js": { "maxDuration": 30 },
    "api/public.js": { "maxDuration": 10 }
  }
}
